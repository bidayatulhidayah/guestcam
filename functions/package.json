{
  "name": "@guestcam/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions (asia-southeast1). Bundled with esbuild so @guestcam/shared is built in.",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=lib/index.js --packages=external --alias:@guestcam/shared=../shared/src/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@guestcam/shared": "^0.1.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
