# Copy to web/.env.local and fill in. Never commit .env.local.
# Firebase web config: Firebase console > Project settings > Your apps > Web app,
# or `firebase apps:sdkconfig web`.

# Public address used for QR codes and share links (no trailing slash). The ONE domain setting.
VITE_PUBLIC_BASE_URL=https://<site>.web.app

# Owner line in the copyright footer.
VITE_COPYRIGHT_OWNER=Hidayah

# The dev server uses the emulators unless this is "false".
# VITE_USE_EMULATORS=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
