rules_version = '2';

// Security rules. Every change needs tests in rules-tests/ in the same commit
// (AGENTS.md rule 13). Rules are not filters: queries must match them.
//
// Phase 1: spaces, events, members, guests (1a) and media (1b).
// Guests never read spaces/*: it holds the plan, space number and
// entitlements, and rules cannot hide single fields (pitfall P1). The guest
// app gets what it needs from the resolveCurrentEvent / joinEvent functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSuperadmin() {
      return signedIn() && request.auth.token.get('superadmin', false) == true;
    }

    function hostDoc(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId)/hosts/$(request.auth.uid);
    }

    // Space owners (each partner) and the super admin. Moderators are not owners.
    function isSpaceOwner(spaceId) {
      return isSuperadmin()
        || (signedIn() && exists(hostDoc(spaceId)) && get(hostDoc(spaceId)).data.role == 'owner');
    }

    function eventSpaceId(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.spaceId;
    }

    // Membership is written only by joinEvent after a correct code (D-036).
    function isMember(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    // ---- Spaces and indexes: server and owners only ------------------------

    match /spaces/{spaceId} {
      allow read: if isSpaceOwner(spaceId);
      allow write: if false;

      match /hosts/{uid} {
        allow read: if isSelf(uid) || isSpaceOwner(spaceId);
        allow write: if false;
      }

      match /purchases/{purchaseId} {
        allow read: if isSpaceOwner(spaceId);
        allow write: if false;
      }
    }

    match /publicIds/{publicId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /aliasBookings/{bookingId} {
      allow read, write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /auditLog/{entryId} {
      allow read: if isSpaceOwner(resource.data.spaceId);
      allow write: if false;
    }

    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Events ------------------------------------------------------------

    match /events/{eventId} {
      allow read: if isMember(eventId) || isSpaceOwner(resource.data.spaceId);
      allow write: if false;

      // Event code and linked events: functions only.
      match /private/{docId} {
        allow read, write: if false;
      }

      match /members/{uid} {
        allow read: if isSelf(uid) || isSpaceOwner(eventSpaceId(eventId));
        allow write: if false;
      }

      // Guest profile. galleryUnlocked and firstUploadAt are server-written
      // (pitfall P3), so a guest cannot open the gallery without uploading.
      match /guests/{uid} {
        allow read: if isSelf(uid) || isSpaceOwner(eventSpaceId(eventId));
        allow create: if isSelf(uid) && isMember(eventId) && validGuestCreate(eventId, uid);
        allow update: if isSelf(uid) && isMember(eventId) && validGuestUpdate(eventId, uid);
        allow delete: if false;
      }

      // Media items. The guest creates the doc as "queued" before uploading
      // (pitfall U2); the upload trigger moves it on. Phase 1 has no gallery,
      // so only the owner and space owners can read items (public reads
      // arrive with the gallery lock in Phase 3, pitfall P3).
      match /media/{mediaId} {
        // A member may learn that an item does NOT exist yet: the upload queue
        // checks before creating, so a retry never duplicates (pitfall U1).
        // Ids are random UUIDs, so this reveals nothing.
        allow get: if resource == null && isMember(eventId);
        allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid)
          || isSpaceOwner(resource.data.spaceId);
        allow create: if isMember(eventId) && validMediaCreate(eventId, mediaId);
        allow update: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && isMember(eventId)
          && validMediaUpdate();
        // A server trigger deletes the files when the doc goes (D-062).
        allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid)
          || isSpaceOwner(resource.data.spaceId);

        // Location and whitelisted EXIF: written once by the item's owner,
        // readable only by space owners (rule 10, pitfall P1).
        match /private/{docId} {
          allow read: if isSpaceOwner(eventSpaceId(eventId));
          allow create: if docId == 'meta'
            && signedIn()
            && get(/databases/$(database)/documents/events/$(eventId)/media/$(mediaId)).data.ownerUid == request.auth.uid
            && validMetaCreate();
          allow update, delete: if false;
        }
      }
    }

    // ---- Media validation --------------------------------------------------

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Feature toggles (rule 17): the space is entitled AND the event enabled it.
    function featureAvailable(spaceId, eventData, feature) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data.entitlements.get(feature, false) == true
        && eventData.enabledFeatures.get(feature, false) == true;
    }

    function nullOrNumber(value) {
      return value == null || value is number;
    }

    function validMediaCreate(eventId, mediaId) {
      let data = request.resource.data;
      let event = eventDoc(eventId);
      return mediaId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && data.keys().hasOnly([
          'eventId', 'spaceId', 'folderId', 'ownerUid', 'source', 'type', 'status', 'visibility',
          'hidden', 'showName', 'ownerName', 'ownerSelfieThumbPath', 'contentType', 'sizeBytes',
          'width', 'height', 'durationMs', 'originalPath', 'displayPath', 'thumbPath', 'posterPath',
          'decoration', 'decoratedPath', 'capturedAt', 'capturedAtSource', 'uploadedAt', 'sortAt',
          'createdAt', 'updatedAt'])
        && data.keys().hasAll([
          'eventId', 'spaceId', 'folderId', 'ownerUid', 'source', 'type', 'status', 'visibility',
          'hidden', 'showName', 'ownerName', 'ownerSelfieThumbPath', 'contentType', 'sizeBytes',
          'width', 'height', 'durationMs', 'originalPath', 'displayPath', 'thumbPath', 'posterPath',
          'decoration', 'decoratedPath', 'capturedAt', 'capturedAtSource', 'uploadedAt', 'sortAt',
          'createdAt', 'updatedAt'])
        && data.eventId == eventId
        && data.spaceId == event.spaceId
        && data.folderId == null
        && data.ownerUid == request.auth.uid
        // Phase 1 capture functions and the media types each may create.
        && ((data.source == 'snapshot' && data.type == 'image')
          || (data.source == 'galleryUpload' && data.type in ['image', 'video']))
        && featureAvailable(event.spaceId, event, data.source)
        && request.time < event.uploadUntil
        && data.status == 'queued'
        && data.visibility in ['private', 'public']
        && data.hidden == false
        && data.showName is bool
        // Server-written fields start empty.
        && data.ownerName == null
        && data.ownerSelfieThumbPath == null
        && data.displayPath == null
        && data.thumbPath == null
        && data.posterPath == null
        && data.decoration == null
        && data.decoratedPath == null
        && data.uploadedAt == null
        && data.sortAt == null
        && data.contentType is string
        && data.contentType.matches(data.type + '/[-+.a-zA-Z0-9]+')
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && data.sizeBytes <= 4 * 1024 * 1024 * 1024
        && nullOrNumber(data.width)
        && nullOrNumber(data.height)
        && nullOrNumber(data.durationMs)
        && data.originalPath == 'events/' + eventId + '/media/' + request.auth.uid + '/original/' + mediaId
        && (data.capturedAt == null || data.capturedAt is timestamp)
        && data.capturedAtSource in ['exif', 'device', 'upload']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Owners may switch private/public and show-name; nothing else.
    function validMediaUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visibility', 'showName', 'updatedAt'])
        && request.resource.data.visibility in ['private', 'public']
        && request.resource.data.showName is bool
        && request.resource.data.updatedAt == request.time;
    }

    function validMetaCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly(['location', 'exif', 'originalFileName'])
        && data.keys().hasAll(['location', 'exif', 'originalFileName'])
        && (data.location == null
          || (data.location.keys().hasOnly(['lat', 'lng', 'accuracyM', 'source'])
            && data.location.lat is number
            && data.location.lng is number
            && nullOrNumber(data.location.accuracyM)
            && data.location.source in ['exif', 'device']))
        && data.exif is map
        && data.exif.size() <= 40
        && (data.originalFileName == null
          || (data.originalFileName is string && data.originalFileName.size() <= 255));
    }

    // ---- Guest validation --------------------------------------------------

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    function validSelfiePath(path, eventId, uid) {
      return path == null
        || (path is string
          && path.matches('events/' + eventId + '/guests/' + uid + '/selfie[.](jpg|jpeg|png|webp)'));
    }

    function validGuestFields(data, eventId, uid) {
      return validName(data.displayName)
        && validSelfiePath(data.selfiePath, eventId, uid)
        && (data.lastVisibility == null || data.lastVisibility in ['private', 'public'])
        && data.showName is bool
        && data.language in ['ms', 'en'];
    }

    function validGuestCreate(eventId, uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'displayName', 'selfiePath', 'selfieThumbPath', 'galleryUnlocked', 'firstUploadAt',
          'lastVisibility', 'showName', 'language', 'joinedAt'])
        && data.keys().hasAll([
          'displayName', 'selfiePath', 'selfieThumbPath', 'galleryUnlocked', 'firstUploadAt',
          'lastVisibility', 'showName', 'language', 'joinedAt'])
        && validGuestFields(data, eventId, uid)
        && data.selfieThumbPath == null
        && data.galleryUnlocked == false
        && data.firstUploadAt == null
        && data.joinedAt == request.time;
    }

    function validGuestUpdate(eventId, uid) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'selfiePath', 'lastVisibility', 'showName', 'language'])
        && validGuestFields(request.resource.data, eventId, uid);
    }
  }
}
