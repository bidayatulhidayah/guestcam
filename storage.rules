rules_version = '2';

// Storage rules. Every change needs tests in rules-tests/ in the same commit
// (AGENTS.md rule 13). Phase 1: the guest selfie (1a) and media originals (1b).
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(eventId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    // Space owners, looked up through the event (two Firestore reads). A
    // missing host doc makes the get() fail, which denies.
    function isEventSpaceOwner(eventId) {
      return signedIn()
        && (request.auth.token.get('superadmin', false) == true
          || firestore.get(/databases/(default)/documents/spaces/$(
              firestore.get(/databases/(default)/documents/events/$(eventId)).data.spaceId
            )/hosts/$(request.auth.uid)).data.role == 'owner');
    }

    // Guest profile selfie: never an upload, never in a gallery.
    // Retaking a selfie replaces the file, so writes are allowed for the owner.
    match /events/{eventId}/guests/{uid}/{fileName} {
      allow read: if (signedIn() && request.auth.uid == uid) || isEventSpaceOwner(eventId);
      allow write: if signedIn()
        && request.auth.uid == uid
        && fileName.matches('selfie[.](jpg|jpeg|png|webp)')
        && request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && isMember(eventId);
      allow delete: if false;
    }

    // Media originals (rule 11): a guest uploads only into their own folder,
    // only after creating the queued media doc (pitfall U2), with the size and
    // type that doc declares. Create-only: originals are never overwritten
    // (rule 3) and guests never delete files; a server trigger does (D-062).
    match /events/{eventId}/media/{uid}/original/{mediaId} {
      allow read: if (signedIn() && request.auth.uid == uid) || isEventSpaceOwner(eventId);
      allow create: if signedIn()
        && request.auth.uid == uid
        // No file there yet: never overwrite an original, even if the
        // platform treats a re-upload as a create.
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.+')
        && queuedMediaMatches(eventId, mediaId, uid);
      allow update, delete: if false;
    }

    function queuedMediaMatches(eventId, mediaId, uid) {
      let media = firestore.get(/databases/(default)/documents/events/$(eventId)/media/$(mediaId)).data;
      return media.ownerUid == uid
        && media.status == 'queued'
        && media.sizeBytes == request.resource.size
        && media.contentType == request.resource.contentType;
    }

    // Everything else: denied until its phase adds rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
